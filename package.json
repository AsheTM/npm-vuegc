{
  "name": "vuegc",
  "version": "1.3.1",
  "description": "CLI to generate a Vue 2 single-file component in your project src/ folder",
  "main": "vuegc.js",
  "types": "vuegc.d.ts",
  "files": [
    "vuegc.js",
    "vuegc.d.ts",
    "services/",
    "template/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
