  },
  "homepage": "https://github.com/AsheTM/npm-vuegc#readme",
  "bugs": {
    "url": "https://github.com/AsheTM/npm-vuegc/issues"
  },
  "dependencies": {
    "handlebars": "^4.7.10"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
